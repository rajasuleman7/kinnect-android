<?xml version="1.0" encoding="utf-8"?>
<FrameLayout 
    xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#99000000">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#AAFFFFFF">
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
            <ImageButton android:id="@+id/btn_back" android:layout_width="40dp" android:layout_height="40dp" android:background="@android:color/transparent" android:src="@drawable/arrow_back"/>
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Lina's post" android:textStyle="bold" android:textSize="20sp"/>
        </LinearLayout>
        <ImageView android:layout_width="match_parent" android:layout_height="260dp" android:src="@drawable/kinnect_mountain_sunset" android:scaleType="centerCrop"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Most relevant
  AK   Aisha Khan
        That sky is unreal." android:padding="18dp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="68dp" android:layout_gravity="center" android:layout_marginHorizontal="24dp" android:orientation="horizontal" android:gravity="center" android:background="@drawable/bg_white_rounded">
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/like"/>
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/love"/>
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/haha"/>
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/wow"/>
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/sad"/>
        <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/angry"/>
    </LinearLayout>
</FrameLayout>