<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/white">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp">
        <TextView android:id="@+id/btn_cancel" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Cancel"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="Recents⌄" android:textStyle="bold" android:textSize="20sp"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="Next (2)" android:textColor="@color/kinnect_teal" android:textStyle="bold"/>
    </LinearLayout>
    <ImageView android:layout_width="match_parent" android:layout_height="250dp" android:src="@drawable/kinnect_mountain_sunset" android:scaleType="centerCrop"/>
    <GridLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:columnCount="4" android:rowCount="3">
        <ImageView android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:src="@drawable/kinnect_mountain_sunset" android:scaleType="centerCrop"/>
        <ImageView android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:src="@drawable/kinnect_lake_view" android:scaleType="centerCrop"/>
        <ImageView android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:src="@drawable/kinnect_car_horse" android:scaleType="centerCrop"/>
        <ImageView android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:src="@drawable/kinnect_motorbike" android:scaleType="centerCrop"/>
        <ImageView android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:src="@drawable/kinnect_food" android:scaleType="centerCrop"/>
        <ImageView android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:src="@drawable/kinnect_car" android:scaleType="centerCrop"/>
    </GridLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:orientation="horizontal">
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Gallery" android:textColor="@color/kinnect_teal" android:textStyle="bold"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Photo"/>
        <TextView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:text="Video"/>
    </LinearLayout>
</LinearLayout>