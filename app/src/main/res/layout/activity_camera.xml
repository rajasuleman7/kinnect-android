<?xml version="1.0" encoding="utf-8"?>
<FrameLayout 
    
    xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/black">
    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/kinnect_motorbike" android:scaleType="centerCrop"/>
    <ImageButton android:id="@+id/btn_close" android:layout_width="44dp" android:layout_height="44dp" android:layout_gravity="top|end" android:layout_margin="18dp" android:background="@drawable/bg_dark_circle" android:src="@drawable/close" android:tint="@color/white"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="150dp" android:layout_gravity="bottom" android:orientation="vertical" android:gravity="center" android:background="#CC000000">
        <LinearLayout android:layout_width="match_parent" android:layout_height="90dp" android:orientation="horizontal" android:gravity="center">
            <ImageButton android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_dark_circle" android:src="@drawable/image" android:tint="@color/white"/>
            <ImageButton android:id="@+id/btn_shutter" android:layout_width="76dp" android:layout_height="76dp" android:layout_marginHorizontal="34dp" android:background="@drawable/bg_white_circle"/>
            <ImageButton android:layout_width="52dp" android:layout_height="52dp" android:background="@drawable/bg_dark_circle" android:src="@drawable/flip_camera_android" android:tint="@color/white"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="TEXT     LIVE     STORY     POST     BOOMERANG" android:textColor="@color/white" android:textStyle="bold"/>
    </LinearLayout>
</FrameLayout>